# ---- Core Flask settings ----
# A long random string used to sign session cookies and CSRF tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# development | production
FLASK_ENV=development

# ---- Database ----
# Local dev (SQLite, default if unset): sqlite:///us.db
# Production (Supabase Postgres) looks like:
# postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///us.db

# ---- Cookies ----
# Set to "true" only when serving over HTTPS (production). Keep "false" for
# local http://127.0.0.1 development or the login cookie will not be set.
SESSION_COOKIE_SECURE=false
